# .env

# Leave these blank if you're running locally only
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Graph-first experiment: an OpenAI-compatible endpoint serving the exact
# Llama-3.1-70B-Instruct and Qwen-2.5-72B-Instruct model weights.
# Leave GRAPH_MODEL_BASE_URL blank to look for both models in local Ollama.
GRAPH_MODEL_BASE_URL=
GRAPH_MODEL_API_KEY=
# Set these only if the server uses different API model IDs.
PAPER_LLAMA_MODEL_ID=llama3.1:70b
PAPER_QWEN_MODEL_ID=qwen2.5:72b

# Local Ollama adaptation (--model-mode local). Profile and dialogue share
# Mistral-Nemo; Qwen 7B handles extraction, themes, review, and comparison.
# All stages use local Ollama, even when GRAPH_MODEL_BASE_URL is set above.
LOCAL_PROCESS_MODEL_ID=qwen2.5:7b
LOCAL_EDGE_MODEL_ID=qwen2.5:14b
LOCAL_PROFILE_MODEL_ID=mistral-nemo
LOCAL_JUDGE_MODEL_ID=qwen2.5:7b

# Ollama runs on localhost (no key needed)
OLLAMA_BASE_URL=http://localhost:11434

DEFAULT_THERAPIST_MODEL=llama3.1
DEFAULT_PATIENT_MODEL=llama3.1
