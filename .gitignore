# secrets
.env

# JetBrains
.idea/

# Per-condition case YAMLs written by run_symptom_experiments.py. It always
# names them "<prefix>_<case>_<symptom>_run_<n>.yaml", so matching on _run_
# covers every prefix without listing them, and admits hand-written cases
# automatically. (An earlier version re-admitted cases by name and silently
# swallowed the next new one.)
config/priors/patient/cases/*_run_*.yaml

# uv / python
.venv/
__pycache__/
*.pyc
*.pyo
.python-version

# Batch-generation console logs. They belong in data/results/_logs/ (already
# covered by data/* below), but a `nohup ... > run.log` launched from the repo
# root writes to the CWD, so an unqualified redirect lands here instead. Ignored
# wherever they appear: they are heavy, regenerable, and a session's real record
# is its own directory under data/sessions/.
*.log

# All of data/ is ignored: raw sessions and derived outputs are heavy and
# regenerable.
data/*
manuscript/
result/
requested_20260908_no_complaint_new_280 (2)/
requested_20260908_no_complaint_new_280.zip
requested_20260908_no_complaint_new_280/


# streamlit
.streamlit/

# OS
.DS_Store
Thumbs.db

# Working notes and papers now live under manuscript/ (ignored wholesale above):
