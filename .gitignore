# secrets
.env

# JetBrains
.idea/

# Per-condition case YAMLs written by run_symptom_experiments.py. It always
# names them "<prefix>_<case>_<symptom>_run_<n>.yaml", so matching on _run_
# covers every prefix and admits hand-written cases automatically.
config/priors/patient/cases/*_run_*.yaml

# Local design declarations and analysis specification; start from the
# matching *.example.yaml.
config/designs.yaml
config/analysis_spec.yaml

# uv / python
.venv/
__pycache__/
*.pyc
*.pyo
.python-version

# Batch-generation console logs, wherever a redirect leaves them. A session's
# record is its own directory under data/sessions/.
*.log

# Coverage data and reports.
.coverage
.coverage.*
htmlcov/
coverage.xml

# Sessions and derived outputs: heavy and regenerable.
data/*
result/

# Local working notes.
manuscript/

# streamlit
.streamlit/

# OS
.DS_Store
Thumbs.db
